# Salin file ini menjadi .env.local lalu isi nilainya dari
# Supabase Dashboard -> Project Settings -> API.
# Jangan commit .env.local (sudah di-ignore oleh .gitignore).

# Dipakai sisi server (dapat di-akses tanpa NEXT_PUBLIC_)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Dipakai browser & middleware (WAJIB ada, ikut ter-bundle ke klien)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>